# GDPR settings. Copy this file to .env.
# Set GDPR_TOKEN; README step B3 (setup) fills in OWNER_ID, HQ_ID, CHATS_ID and AGENT_IDS.
# No quotes, no spaces around "=". Never commit .env or share it: it holds your bot token.

# Bot token: Discord Developer Portal > your application > Bot > Reset Token.
GDPR_TOKEN=

# User ID of the person who controls GDPR. Only they can use slash commands and /secret.
OWNER_ID=

# Optional: the owner's name as it should appear in GDPR's messages.
OWNER_NAME=

# The #gdpr-hq channel: where you talk to GDPR and where it posts its log.
HQ_ID=

# The #gdpr-threads channel: where the private threads are created.
CHATS_ID=

# Agent bots: short name = bot user ID, comma separated, no spaces, e.g. dev=1234...,ops=5678...
# The short names are what you type in commands (@GDPR add dev). Several names may share one ID.
AGENT_IDS=

# Optional: names from AGENT_IDS that only the owner may bring into threads, e.g. admin
RESTRICTED_AGENTS=

# Optional: folder on the host where /secret values are saved (default ./secrets).
# If you change it, the folder must be owned by uid 10001 with mode 700.
# SECRET_INBOX_DIR=./secrets

# Optional: deposit /secret values into a Vaultwarden collection instead of the folder above.
# Needs docker-compose.vault.yml (README). All three must be set; then there is no fallback to the folder.
# VW_URL=https://vault.example.com
# VW_ORG_ID=
# VW_COLLECTION_ID=

# Optional card watcher (see README, Settings): posts one line in a card's notify_thread when the card
# enters Reviewing, is labelled blocked, or stalls In Progress. Off unless URL, board and key are set.
# PLANKA_URL=https://kanban.example.com
# PLANKA_BOARD_ID=
# PLANKA_API_KEY=
# PLANKA_STALL_HOURS=24
