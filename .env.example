# GDPR settings. Copy this file to .env.
# Part B of README.md fills in the empty values (step B3 looks most of them up for you).
# No quotes, no spaces around "=". Never commit .env or share it: it holds your bot token.

# Bot token: Discord Developer Portal > your application > Bot > Reset Token.
GDPR_TOKEN=

# User ID of the person who controls GDPR. Only they can use slash commands and /secret.
OWNER_ID=

# Optional: the owner's name as it should appear in GDPR's messages.
OWNER_NAME=

# Channel where you talk to GDPR (@mention it) and where it posts its log.
HQ_ID=

# Channel that holds the private threads. Can be the same channel as HQ_ID.
CHATS_ID=

# Agent bots: short name = bot user ID, comma separated, no spaces, e.g. dev=1234...,ops=5678...
# The short names are what you type in commands: open "topic" dev ops | message
AGENT_IDS=

# Optional: folder on the host where /secret values are saved (default ./secrets).
# If you change it, the folder must be owned by uid 10001 with mode 700.
# SECRET_INBOX_DIR=./secrets
